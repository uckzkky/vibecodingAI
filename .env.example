# 使用说明：
# 1. 复制本文件为 .env（与 requirements.txt 同级）
# 2. 填入你在 DeepSeek 等平台申请的密钥
# 3. 切勿把 .env 提交到 Git 或发给他人

# —— DeepSeek（推荐：本项目网页「乐评」默认走 DeepSeek）——
# 若同时填写 OPENAI_API_KEY，程序会优先使用 OpenAI 兼容接口，而不是 DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# —— OpenAI 或兼容网关（可选，优先级高于 DeepSeek）——
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# —— 本机 Ollama（可选：未配置上述密钥时会自动尝试连接本机）——
# OLLAMA_MODEL=qwen2.5:7b
